# Copy this file to .env and adjust the values. Never commit your real .env.

# Ollama's OpenAI-compatible endpoint (note the /v1 at the end)
BASE_URL=http://127.0.0.1:11434/v1

# Ollama does not need a key, but the OpenAI client requires some value
API_KEY=dummy

# Must match a model you pulled: run `ollama list` to see exact names
MODEL=qwen3:4b

# Set to True (capital T) to print the grey step-by-step trace of tool calls
DEBUG=False
